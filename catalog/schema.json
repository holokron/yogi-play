{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yogi-play.pl/catalog/schema.json",
  "title": "Yogi PLAY sound catalog",
  "description": "sounds.json is an array of $defs/sound, tags.json an array of $defs/tag. Array position is display order.",
  "$defs": {
    "sound": {
      "type": "object",
      "required": ["id", "name", "path", "tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^https://" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "isNew": { "type": "boolean" }
      }
    },
    "tag": {
      "type": "object",
      "required": ["id", "slug", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "sounds": { "type": "array", "items": { "$ref": "#/$defs/sound" } },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" } }
  }
}
