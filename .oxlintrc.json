{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y",
    "vitest"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@/lib/app"]
      }
    ]
  },
  "ignorePatterns": ["build", "dist", "coverage", "public"],
  "overrides": [
    {
      "files": ["scripts/**"],
      "env": {
        "node": true
      }
    }
  ]
}
